{
  "name": "dock-n-roll",
  "version": "1.1.0",
  "private": true,
  "description": "GNOME top-bar launcher for local dev services: one-click ON/OFF for Docker Compose projects + background activity monitor",
  "license": "UNLICENSED",
  "homepage": "https://github.com/benoit-bremaud/dock-n-roll",
  "desktopName": "dock-n-roll.desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benoit-bremaud/dock-n-roll.git"
  },
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "pnpm audit --audit-level=high",
    "sonar": "vitest run --coverage && SONAR_TOKEN=\"$(cat \"$HOME/.config/sonar-tokens/dock-n-roll\")\" sonar-scanner",
    "dist": "electron-vite build && electron-builder --linux deb --publish never",
    "e2e:smoke": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.4",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "author": {
    "name": "Benoît Bremaud"
  }
}
