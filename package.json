{
  "name": "dock-n-roll",
  "version": "0.1.0",
  "private": true,
  "description": "GNOME top-bar launcher for local dev services: one-click ON/OFF for Docker Compose projects + background activity monitor",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "start": "install-electron && electron-vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "vitest run",
    "audit": "pnpm audit --audit-level=high",
    "dist": "electron-vite build && electron-builder --linux deb"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "author": {
    "name": "Benoît Bremaud"
  }
}
